{
  "expo": {
    "name": "Inventario",
    "slug": "inventario",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "La app usa la cámara para fotografiar tus productos.",
          "photosPermission": "La app accede a tus fotos para elegir una imagen del producto.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "inventario"
  }
}
